# Vercel (vercel.json): what neither the build nor the site needs, never uploaded.
# The function's excludeFiles repeats the big ones, in case a Git build ignores this file.
reports/
# The film's sources at the root only: «video/» alone also matched web/public/video,
# so the lesson videos and the sales page's clip never reached the site.
/video/
docker/
.github/
docs/
api/tests/
financials/test/
curso/1_contenido/referencia/
curso/1_contenido/curso_completo.md
curso/1_contenido/pdf/curso_completo.pdf
curso/2_plantilla_financiera/originales/
curso/2_plantilla_financiera/herramientas/
# The package's checks stay out, but not the two worked examples the professional
# template's calculator loads (FinancialsController::inputs).
curso/2_plantilla_financiera/pruebas/*
!curso/2_plantilla_financiera/pruebas/escenario_24_viviendas.json
!curso/2_plantilla_financiera/pruebas/escenario_guia_profesional.json
# The package's lesson videos: the site serves its copies in web/public/video.
curso/4_videos/
curso/2_plantilla_financiera/plantilla/plantilla_libre_original.json
curso/2_plantilla_financiera/plantilla/entradas_original.json
curso/2_plantilla_financiera/plantilla/correcciones.json
# Laravel's default front-end scaffolding, unused (the front end is web/): under
# api/, Vercel would build each .js file as a function of its own.
api/package.json
api/vite.config.js
api/resources/js/
api/resources/css/
