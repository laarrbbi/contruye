{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix web --no-audit --no-fund",
  "buildCommand": "VITE_API_URL=same-origin VITE_SITE_URL= npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/vercel.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60,
      "excludeFiles": "{.git,**/.git,.vercel,.claude,node_modules,deploy,traducciones,docs,api/{tests,node_modules,storage/logs,storage/framework},web/{node_modules,dist,public,*-sources},curso/4_videos,curso/2_plantilla_financiera/{originales,herramientas}}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/vercel.php" },
    { "source": "/sanctum/:path*", "destination": "/api/vercel.php" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
