# Production environment — copy to api/.env on the server and fill every blank.
#
#   cp .env.production.example .env && php artisan key:generate
#
# deploy/deploy.sh runs `php artisan app:check-secrets --strict` before it
# touches anything: it refuses blank secrets, test-mode payment keys, the
# Chargily test endpoint, debug mode, insecure cookies, http:// URLs and mail
# that goes to the log. Blank is never "off" — a gateway that is not ready
# yet is switched off with its *_ENABLED flag below.
#
# The domain below is a placeholder: replace every "example.dz".

APP_NAME="Ebni Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The SPA and the API share one origin: nginx serves web/dist and passes
# /api, /sanctum and /up to Laravel (deploy/nginx/ebni.conf).
APP_URL=https://example.dz
FRONTEND_URL=https://example.dz

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file per day, two weeks kept. Webhook logs carry order ids, never the
# buyer's name, e-mail or card details.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ebni
DB_USERNAME=ebni
DB_PASSWORD=

SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=example.dz
SANCTUM_STATEFUL_DOMAINS=example.dz

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Webhooks and every e-mail go through the queue: supervisor keeps
# `queue:work` running (deploy/supervisor/ebni-queue.conf).
QUEUE_CONNECTION=database
CACHE_STORE=database

# Real SMTP. Send one test message and check it arrives before go-live:
#   php artisan tinker --execute="Mail::raw('Test Ebni', fn (\$m) => \$m->to('you@example.dz')->subject('Test'));"
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@example.dz"
MAIL_FROM_NAME="${APP_NAME}"

# --- Chargily Pay v2 (CIB / Edahabia, DZD) ----------------------------------
# Live keys from the Chargily dashboard, and the production endpoint (no /test).
# Webhook URL to register there: https://example.dz/api/webhooks/chargily
# Not signed up yet? CHARGILY_ENABLED=false and launch with CCP / BaridiMob.
CHARGILY_ENABLED=true
CHARGILY_API_KEY=
CHARGILY_SECRET=
CHARGILY_BASE_URL=https://pay.chargily.net/api/v2
CHARGILY_TEST_MODE=false

# --- Stripe (diaspora, EUR) --------------------------------------------------
# The owner decides whether euro payments launch. Either fill both keys
# (webhook URL: https://example.dz/api/webhooks/stripe) or set
# STRIPE_ENABLED=false. Left like this, the deploy refuses to run — on purpose.
STRIPE_ENABLED=true
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Bunny Stream (lesson videos) --------------------------------------------
# Library id and the Embed View Token Authentication key.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_TOKEN_KEY=
BUNNY_EMBED_TTL=14400

# --- Manual payment details shown to the buyer -------------------------------
# A method whose details are blank is not offered at checkout.
PAYMENT_CCP_NUMBER=
PAYMENT_CCP_NAME=
PAYMENT_BARIDIMOB_RIP=

# --- Search engines (optional) -----------------------------------------------
# Ownership tokens for Google Search Console and Bing Webmaster Tools, when
# verifying with a meta tag rather than a DNS record. Only the token, not the
# whole tag. Blank means no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
