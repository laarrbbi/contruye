APP_NAME="Ebni Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ebni
DB_USERNAME=ebni
DB_PASSWORD=secret

# Cookies default to Secure. Local dev is plain HTTP, so it is off here.
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@ebni.dz"
MAIL_FROM_NAME="${APP_NAME}"

# Chargily Pay v2 (test mode) — https://pay.chargily.com
# CHARGILY_ENABLED=false switches card payments off on purpose (CCP-only launch).
# Blank keys are not "off": app:check-secrets --strict fails on them.
CHARGILY_ENABLED=true
CHARGILY_API_KEY=test_pk_placeholder
# ---------------------------------------------------------------------------
# SECRETS — a blank value here is NOT "feature disabled".
# A blank webhook secret makes signature verification pass for anything, so the
# services refuse to verify at all until it is set, and payments cannot be
# confirmed. Run `php artisan app:check-secrets --strict` before serving traffic.
# ---------------------------------------------------------------------------
CHARGILY_SECRET=test_sk_placeholder
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2
CHARGILY_TEST_MODE=true

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_TOKEN_KEY=
BUNNY_EMBED_TTL=14400

# Manual payment details shown at checkout
PAYMENT_CCP_NUMBER="0000000000 clé 00"
PAYMENT_CCP_NAME="EBNI ACADEMY SARL"
PAYMENT_BARIDIMOB_RIP="00799999000000000000"

# Stripe (diaspora / EUR) — STRIPE_ENABLED=false switches it off on purpose.
STRIPE_ENABLED=true
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
