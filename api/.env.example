APP_NAME="Construye Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=construye
DB_USERNAME=construye
DB_PASSWORD=secret

# Cookies default to Secure. Local dev is plain HTTP, so it is off here.
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@construye.es"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (card payments in euros, test mode) — https://dashboard.stripe.com
# STRIPE_ENABLED=false switches card payments off on purpose (a launch with
# bank transfer and Bizum only). Blank keys are not "off":
# app:check-secrets --strict fails on them.
STRIPE_ENABLED=true
# ---------------------------------------------------------------------------
# SECRETS — a blank value here is NOT "feature disabled".
# A blank webhook secret makes signature verification pass for anything, so the
# services refuse to verify at all until it is set, and payments cannot be
# confirmed. Run `php artisan app:check-secrets --strict` before serving traffic.
# ---------------------------------------------------------------------------
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_TOKEN_KEY=
BUNNY_EMBED_TTL=14400

# Manual payment details shown at checkout (placeholders)
PAYMENT_TRANSFER_IBAN="ES00 0000 0000 0000 0000 0000"
PAYMENT_TRANSFER_HOLDER="[DEMO] Construye Academy S.L."
PAYMENT_BIZUM_PHONE="600000000"
