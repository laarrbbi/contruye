<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The suite's own SPA origin: tests must not depend on the port a
             developer's local .env happens to use for the dev server. -->
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173,localhost:8000"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="mysql-test"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="construye_test"/>
        <env name="DB_USERNAME" value="construye"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Third-party credentials are pinned blank: a test that needs one
             sets it with config(). Left to .env, the suite passed on a laptop
             holding a Stripe key and failed on a clean checkout. -->
        <env name="STRIPE_SECRET" value=""/>
        <env name="STRIPE_WEBHOOK_SECRET" value=""/>
        <env name="BUNNY_STREAM_LIBRARY_ID" value=""/>
        <env name="BUNNY_TOKEN_KEY" value=""/>
    </php>
</phpunit>
